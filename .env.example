# Postgres (dev: container do docker-compose exposto em localhost; produção: Supabase).
# O container `app` recebe o hostname interno `db` via docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_leads?schema=public"

# Login do painel admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme"

# Segredo para assinar o cookie de sessão do admin
SESSION_SECRET="replace-with-a-long-random-string"
