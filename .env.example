# Postgres (dev: container `db` do docker-compose; produção: connection string do Supabase)
DATABASE_URL="postgresql://postgres:postgres@db:5432/crm_leads?schema=public"

# Login do painel admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme"

# Segredo para assinar o cookie de sessão do admin
SESSION_SECRET="replace-with-a-long-random-string"
