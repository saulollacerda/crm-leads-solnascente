// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"

  // Conexão da aplicação. Em produção aponta para o pooler do Supabase:
  // cada função serverless abre a própria conexão e o Postgres tem limite.
  url = env("DATABASE_URL")

  // Migrations precisam de conexão direta — o pooler em modo transação não
  // suporta os comandos de DDL que o migrate usa. Em dev, as duas são iguais.
  directUrl = env("DIRECT_URL")
}

enum Unidade {
  Teresina
  Timon
}

enum StatusLead {
  Novo
  EmContato
  Convertido
  Perdido
}

enum CanalContato {
  WhatsApp
  Telefone
  Email
}

model Lead {
  id String @id @default(uuid())

  // Número que o cliente recebe e usa como referência no atendimento.
  // Gerado por sequência do Postgres: único por construção, e vale para
  // qualquer origem de escrita, não só a API.
  // A expressão está na forma normalizada do Postgres — é assim que ele a devolve
  // na introspecção. Escrita de outro jeito, o `migrate dev` acusa drift a cada
  // execução e pede uma migration nova que não muda nada.
  protocolo String @unique @default(dbgenerated("((('SN-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('protocolo_seq'::regclass))::text, 4, '0'::text))"))

  nome            String
  whatsapp        String
  modeloInteresse String
  unidade         Unidade
  canalPreferido  CanalContato @default(WhatsApp)
  status          StatusLead   @default(Novo)

  // Consentimento LGPD: sem autorização o dado não é gravado, então ambos são obrigatórios.
  consentimentoEm      DateTime
  consentimentoVersao  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([unidade])
  @@index([createdAt])
  @@map("leads")
}
