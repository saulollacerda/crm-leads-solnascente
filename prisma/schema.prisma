generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Unidade {
  Teresina
  Timon
}

enum StatusLead {
  Novo
  EmContato
  Convertido
  Perdido
}

model Lead {
  id              String     @id @default(uuid())
  nome            String
  whatsapp        String
  modeloInteresse String
  unidade         Unidade
  status          StatusLead @default(Novo)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("leads")
}
