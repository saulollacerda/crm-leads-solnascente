generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Unidade {
  Teresina
  Timon
}

enum StatusLead {
  Novo
  EmContato
  Convertido
  Perdido
}

enum CanalContato {
  WhatsApp
  Telefone
  Email
}

model Lead {
  id              String       @id @default(uuid())
  nome            String
  whatsapp        String
  modeloInteresse String
  unidade         Unidade
  canalPreferido  CanalContato @default(WhatsApp)
  status          StatusLead   @default(Novo)

  // Consentimento LGPD: sem autorização o dado não é gravado, então ambos são obrigatórios.
  consentimentoEm      DateTime
  consentimentoVersao  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([unidade])
  @@index([createdAt])
  @@map("leads")
}
